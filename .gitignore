# own pak1.pak (e.g. mods/fq/pak1.pak, a free fan mod's own assets) is
# unrelated and should stay tracked.
/pak1.pak
/pak2.pak
/pak3.pak

# User accounts/sessions database (password hashes) and TLS keys -- never commit.
/server/data/
/server/*.pem
